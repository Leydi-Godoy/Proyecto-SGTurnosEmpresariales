{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Backend (nodemon)",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "nodemon",
      "program": "${workspaceFolder}/backend/index.js",
      "restart": true,
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/backend/.env",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
